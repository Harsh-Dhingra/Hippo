# Copy to deploy/.env and edit. Never commit the result.
# Secrets live here or in a mounted secrets file, never in the repo and never
# in the database (CLAUDE.md, Conventions).

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=hippo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hippo
# Host port to publish Postgres on. Change if 5432 is already taken.
POSTGRES_PORT=5432

# --- App ------------------------------------------------------------------
# Host port for the API.
HIPPO_PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
HIPPO_LOG_LEVEL=INFO
# Apply pending migrations when the API starts. Set false to run
# `hippo-migrate up` as its own deploy stage instead.
HIPPO_MIGRATE_ON_STARTUP=true

# --- Single sign-on (optional) --------------------------------------------
# Leave HIPPO_OIDC_ISSUER empty and Hippo uses local passwords only, which is
# what a laptop install wants. Set it and a "Sign in with SSO" button appears.
#
# Passwords keep working either way, deliberately: an install whose only way in
# is the IdP has no way in when the IdP is the thing that is down.
#
# The issuer's discovery document must declare exactly this value as `issuer`,
# or login is refused — that check is what stops a redirect swapping in a
# different provider.
#HIPPO_OIDC_ISSUER=https://acme.okta.com
#HIPPO_OIDC_CLIENT_ID=
#HIPPO_OIDC_CLIENT_SECRET=
# Must match what is registered with the IdP exactly, and must point at the UI
# rather than the API: the browser lands here, and the UI does the exchange.
#HIPPO_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# `openid` is added whether or not it is listed. `email` is what maps a login
# to the principals carrying its permissions, so without it a session sees
# nothing at all.
#HIPPO_OIDC_SCOPES=openid email profile
#HIPPO_OIDC_BUTTON_LABEL=Sign in with SSO
# false means an administrator provisions people first and an unknown IdP
# subject is refused, for an install that treats signup as an approval.
#HIPPO_OIDC_AUTO_CREATE_USERS=true

# Connector tokens are NOT set here yet; they arrive with P1-SYNC-2.
