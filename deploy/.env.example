# Copy to deploy/.env and edit. Never commit the result.
# Secrets live here or in a mounted secrets file, never in the repo and never
# in the database (CLAUDE.md, Conventions).

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=hippo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hippo
# Host port to publish Postgres on. Change if 5432 is already taken.
POSTGRES_PORT=5432

# --- App ------------------------------------------------------------------
# Host port for the API.
HIPPO_PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
HIPPO_LOG_LEVEL=INFO
# Apply pending migrations when the API starts. Set false to run
# `hippo-migrate up` as its own deploy stage instead.
HIPPO_MIGRATE_ON_STARTUP=true

# Connector tokens are NOT set here yet; they arrive with P1-SYNC-2.
