# syntax=docker/dockerfile:1
#
# The web UI. Third container, and the only one that a browser talks to.
# Build context is the repo root: `docker build -f deploy/Dockerfile.ui .`
#
# It holds no credential of its own. The session token lives in an httpOnly
# cookie this server reads and the browser cannot, so the one secret in play
# never reaches JavaScript. See ui/lib/api.ts.

FROM node:22-bookworm-slim AS build

WORKDIR /app

# Dependencies first, so a source change does not reinstall the world.
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY ui ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build


FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# `output: "standalone"` produces a server with only the modules it uses, which
# is a much smaller thing to keep patched than a full node_modules.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

RUN useradd --create-home --uid 10001 hippo
USER hippo

EXPOSE 3000

CMD ["node", "server.js"]
